<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Lumen</string>
	<key>CFBundleDisplayName</key>
	<string>Lumen</string>
	<key>CFBundleIdentifier</key>
	<string>app.lumen.Lumen</string>
	<key>CFBundleExecutable</key>
	<string>Lumen</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- Shown when Lumen first listens to audio (rekordbox via BlackHole, an interface, a mic). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Lumen listens to your music (for example rekordbox through BlackHole) to make the lights react to bass, kicks, snares and hi-hats. Audio is analysed live and never recorded.</string>
	<!-- macOS 14.2+: needed to capture rekordbox's audio directly (no BlackHole). -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Lumen captures rekordbox's output directly so the lights react to the music without BlackHole. Audio is analysed live and never recorded.</string>
	<!-- Keep DMX running when the window is hidden or another app is in front. -->
	<key>NSAppSleepDisabled</key>
	<true/>
	<!-- macOS 15+: needed to send Art-Net / sACN to lighting nodes on your network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lumen sends Art-Net and sACN to your lighting controllers, looks for Art-Net nodes, and syncs to rekordbox with Ableton Link.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Open source, MIT OR Apache-2.0</string>
</dict>
</plist>
